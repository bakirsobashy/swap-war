; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Swap-War"
config/version="1.0.0"
run/main_scene="res://Scenes/UI/MainMenu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Assets/icon/icon_512.png"

[autoload]

TeamManager="*res://Scripts/Components/TeamManager.gd"
ScoreManager="*res://Scripts/Components/ScoreManager.gd"
ArenaManager="*res://Scripts/Components/ArenaManager.gd"
AudioManager="*res://Scripts/Components/AudioManager.gd"
WeaponDatabase="*res://Scripts/Weapons/WeaponDatabase.gd"
SettingsManager="*res://Scripts/Components/SettingsManager.gd"
HitFeel="*res://Scripts/Components/HitFeel.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

